# MSC + NCM composite device
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_NET_MODE_NCM=y

# USB drive on the "storage" flash partition
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_WL_SECTOR_SIZE_512=y
CONFIG_WL_SECTOR_MODE_PERF=y

# 1 ms tick for the simulated medium delay
CONFIG_FREERTOS_HZ=1000

# Without async IO, long storage operations block the TinyUSB task
CONFIG_ESP_TASK_WDT_INIT=n

# Larger TCP windows and mailboxes, so the TCP test is limited by USB, not by lwIP
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
