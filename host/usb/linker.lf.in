# USB-DWC HAL functions called from the USB Host interrupt handler.
# The archive name and the channel-decode symbol are filled in by CMakeLists.txt
# because they differ between ESP-IDF releases.

[mapping:usb_host_hal_isr]
archive: @USB_HAL_ARCHIVE@
entries:
    if USB_HOST_ISR_HANDLER_IN_IRAM = y:
        usb_dwc_hal:usb_dwc_hal_decode_intr (noflash)
        usb_dwc_hal:usb_dwc_hal_get_chan_pending_intr (noflash)
        usb_dwc_hal:@USB_HAL_CHAN_DECODE_INTR@ (noflash)
        usb_dwc_hal:usb_dwc_hal_chan_activate (noflash)
        usb_dwc_hal:usb_dwc_hal_port_enable (noflash)
